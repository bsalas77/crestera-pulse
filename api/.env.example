# Only for running the API outside Docker (npm run dev / npm test).
# The Docker install uses the repo-root .env instead — see README.
# In production the API refuses to start with example values.

PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_USER=dashboard
DB_PASS=
DB_NAME=dashboard
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
# TRUST_PROXY=1

# The integration tests DROP EVERY TABLE, so they only run against a database
# named *_test (or with ALLOW_DB_RESET=true). Use a throwaway one:
#   DB_NAME=dashboard_test npm test
