# Only for running the API outside Docker (npm run dev / npm test).
# The Docker install uses the repo-root .env instead — see README.
# In production the API refuses to start with example values.
#
# Start a database this can reach (published on 127.0.0.1 by the dev override):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
# and copy DB_PASS from the root .env.

PORT=8000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dashboard
DB_PASS=
DB_NAME=dashboard
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# TRUST_PROXY=1

# The integration tests DROP EVERY TABLE, so they only run against a database
# named *_test (or with ALLOW_DB_RESET=true). Use a throwaway one:
#   docker compose exec db createdb -U dashboard dashboard_test
#   DB_NAME=dashboard_test npm test
