# Local (non-Docker) dev/test config. Copy to .env.
# In production these are validated at boot (src/config/validateEnv.ts) and
# the app refuses to start with the defaults below.

PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_USER=dashboard
DB_PASS=dashboard_pass
DB_NAME=dashboard
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
