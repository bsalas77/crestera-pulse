# Copy this file to .env, then fill in the two REQUIRED secrets below.
# docker-compose refuses to start while either is blank, and the API refuses
# to boot with an example value.
#
# Generate them (any 20+ character random values work):
#   Linux/macOS:      openssl rand -hex 24         # DB_PASS
#                     openssl rand -base64 48      # JWT_SECRET
#   Windows PowerShell (run twice, once per secret):
#     $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

DB_USER=dashboard
DB_PASS=
DB_NAME=dashboard
JWT_SECRET=

# true (default) loads the built-in fictional demo data on first boot.
# Set to false for a real deployment — the schema starts empty and you load
# your own data with `npm run import-data` (see README: "Bring your own data").
SEED_DEMO=true

# --- Deploying beyond localhost (optional; see README "Deploying on a server") ---
# The browser must be able to reach the API at PUBLIC_API_URL, and the API only
# accepts requests from PUBLIC_UI_URL. Rebuild the UI after changing PUBLIC_API_URL.
# PUBLIC_UI_URL=https://pulse.example.com
# PUBLIC_API_URL=https://pulse-api.example.com
# Number of reverse proxies in front of the API (1 for a single nginx/Caddy).
# TRUST_PROXY=1
# Where the "Powered by Crestera" panel links to. Omit for no link.
# CRESTERA_URL=
