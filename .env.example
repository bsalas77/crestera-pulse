# Copy this file to .env before running `docker-compose up --build`.
# Generate a real JWT_SECRET, e.g.: openssl rand -base64 48

DB_USER=dashboard
DB_PASS=change-me-to-a-real-password
DB_NAME=dashboard
JWT_SECRET=change-me-to-a-random-32-plus-character-secret

# true (default) loads the built-in fictional demo data on first boot.
# Set to false for a real deployment — the schema starts empty and you load
# your own data with `npm run import-data` (see README: "Bring your own data").
SEED_DEMO=true
