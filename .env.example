# Crestera Pulse settings. The README's "Quick start" creates .env from this
# file with both secrets filled in for you; you only need to edit it by hand
# for the optional settings further down.
#
# DB_PASS and JWT_SECRET are REQUIRED: docker compose refuses to start while
# either is blank. To fill them in by hand, use any long random value, e.g.
#   Linux/macOS:         openssl rand -hex 32
#   Windows PowerShell:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
# DB_PASS is fixed when the database is first created — see README
# "Troubleshooting" before changing it later.

DB_USER=dashboard
DB_PASS=
DB_NAME=dashboard
JWT_SECRET=

# true (default) loads the built-in fictional demo data on first start.
# Set to false before the first start for real use — the database starts empty
# and you load your own data with the importer (README: "Bring your own data").
SEED_DEMO=true

# --- Where it listens (optional) ---
# Pulse is one web address: the app on UI_PORT, with its API under /api.
# Change the port if 3000 is already in use, then run: docker compose up -d
# UI_PORT=3000
# By default only this machine can connect (127.0.0.1). To let other computers
# connect, see README "Serving it to other people" (a TLS reverse proxy in
# front is the recommended way; 0.0.0.0 opens it to your network directly).
# BIND_ADDRESS=127.0.0.1

# Number of reverse proxies YOU put in front of Pulse (1 for a single
# nginx/Caddy/IIS/load balancer). Leave at 0 without one.
# TRUST_PROXY=0

# Where the "Powered by Crestera" panel links to. Leave unset for no link.
# CRESTERA_URL=
